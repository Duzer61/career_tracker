# PLACEHOLDERS ONLY. Create /srv/projects/career_tracker/.env manually on the VPS.
# Use unquoted values. Generate new secrets locally; never paste them into chat.
# Hexadecimal secrets avoid URL-encoding issues in the existing application.
POSTGRES_USER=career_db_user
POSTGRES_PASSWORD=CHANGE_ME_NEW_RANDOM_HEX_PASSWORD
POSTGRES_DB=career_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_NEW_RANDOM_HEX_PASSWORD
SECRET_KEY=CHANGE_ME_NEW_RANDOM_HEX_SIGNING_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=30
REFRESH_TOKEN_EXP_DAYS=30
ENVIRON=prod
ONLY_ALLOWED_USERNAMES_MODE=on
ALLOWED_USERNAMES=Duzer
SUPERADMIN_LOGIN=Duzer
# To enable signup with CAPTCHA, configure fresh provider keys locally.
SMARTCAPTCHA_SITE_KEY=
SMARTCAPTCHA_SECRET_KEY=
